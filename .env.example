# Copy to .env and replace every "secret_key" value. .env is never committed.
# Generate a secret with:  openssl rand -hex 20

COMPOSE_PROJECT_NAME=uber-pipeline

SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.17
PYTHON_IMAGE=python:3.11-slim-bookworm

SPARK_IMAGE=apache/spark:4.2.0-scala2.13-java17-python3-ubuntu


S3_ADMIN_ACCESS_KEY=admin
S3_ADMIN_SECRET_KEY=secret_key
# Ingestion service: writes raw files and run state
S3_INGEST_ACCESS_KEY=ingest
S3_INGEST_SECRET_KEY=csecret_key
# PySpark jobs: read raw, write processed, quarantine, published and run state
S3_SPARK_ACCESS_KEY=spark
S3_SPARK_SECRET_KEY=secret_key
# Forecasting application: read-only access to published releases
S3_APP_ACCESS_KEY=forecast-app
S3_APP_SECRET_KEY=secret_key

# ---- Scheduler (UTC). Cycles are safe to repeat; finished work is skipped.
MONTHLY_CRON=0 2 1 * *
QUARTERLY_CRON=0 4 1 1,4,7,10 *
# Process everything that has arrived as soon as the stack starts
RUN_ON_START=true
# Seconds to wait before each retry of a failed job
RETRY_DELAYS=30,60,120